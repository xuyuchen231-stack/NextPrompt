{
  "manifest_version": 3,
  "name": "NextPrompt · 下一步",
  "version": "1.3.0",
  "description": "随时补充 ChatGPT 当前任务，或在本轮完成后发送下一步；支持原生附件、对话队列和本地工作台。",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 NextPrompt · 下一步"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "engine.js",
        "adapter.js",
        "ui.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "打开或收起 NextPrompt"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/logo.webp"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ]
    }
  ]
}
